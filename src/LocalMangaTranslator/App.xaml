<Application x:Class="LocalMangaTranslator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0D1117"/>
        <SolidColorBrush x:Key="Panel" Color="#151B23"/>
        <SolidColorBrush x:Key="Panel2" Color="#1B232E"/>
        <SolidColorBrush x:Key="Border" Color="#2B3542"/>
        <SolidColorBrush x:Key="Text" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="Muted" Color="#8B98A8"/>
        <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#202A36"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111821"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1016"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        </Style>
    </Application.Resources>
</Application>
